# {{ ansible_managed }}
{% macro zot_proxy() -%}
ProxyPreserveHost On
ProxyRequests Off
# Keep the encoded slashes used in OCI repository names and blob URLs.
AllowEncodedSlashes NoDecode

# Blob uploads and downloads can keep the backend connection busy for a long
# time. httpd otherwise uses its 60 second TimeOut for proxied connections,
# which aborts large transfers before zot finishes them.
ProxyTimeout {{ zot_apache_proxy_timeout }}
# Registry blobs are large: never inherit a server-wide request body limit.
LimitRequestBody 0

RequestHeader set X-Forwarded-Proto "https"
RequestHeader set X-Forwarded-Host "{{ zot_apache_server_name }}"

ProxyPass / {{ zot_apache_backend_url }}/ nocanon
ProxyPassReverse / {{ zot_apache_backend_url }}/

ErrorLog {{ zot_apache_log_dir }}/{{ zot_apache_server_name }}_error.log
CustomLog {{ zot_apache_log_dir }}/{{ zot_apache_server_name }}_access.log combined
{%- endmacro %}
<VirtualHost *:80>
  ServerName {{ zot_apache_server_name }}
  Redirect permanent / https://{{ zot_apache_server_name }}/
</VirtualHost>
<VirtualHost *:443>
  ServerName {{ zot_apache_server_name }}

  SSLEngine on
  SSLCertificateFile {{ zot_apache_cert }}
  SSLCertificateKeyFile {{ zot_apache_key }}
{% if zot_apache_hsts %}
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
{% endif %}
{{ zot_proxy() | indent(2, true) }}
</VirtualHost>
